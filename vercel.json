{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/enter.js": { "includeFiles": "api/_private/**" },
    "api/admin.js": { "includeFiles": "api/_private/_ui/**" }
  },
  "rewrites": [
    { "source": "/ai-ethics-city", "destination": "/api/enter?app=ai-ethics-city" },
    { "source": "/ai-ethics-city/:path*", "destination": "/api/enter?app=ai-ethics-city&p=:path*" },
    { "source": "/playcity", "destination": "/api/enter?app=playcity" },
    { "source": "/playcity/:path*", "destination": "/api/enter?app=playcity&p=:path*" },
    { "source": "/playcity-standalone.html", "destination": "/api/enter?app=playcity-standalone" },
    { "source": "/class-admin", "destination": "/api/admin" }
  ]
}
